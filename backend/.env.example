# Node.js backend
PORT=3000

# MongoDB connection
MONGODB_URI=mongodb://127.0.0.1:27017/qubera

# Python quantum simulation service (internal, never exposed to the browser)
QUANTUM_SERVICE_URL=http://localhost:8000
# Upstream request timeout (ms) for quantum simulation
QUANTUM_SERVICE_TIMEOUT_MS=60000

# JWT secret used to sign auth tokens
JWT_SECRET=change_me_to_a_long_random_string

# Google OAuth (backend verifies ID tokens)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Frontend URL (used for OAuth callbacks and password-reset links)
FRONTEND_URL=http://localhost:5173

# GitHub OAuth (backend-only, never exposed to the browser)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# SMTP for email verification / password reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password