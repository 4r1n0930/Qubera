# Base URL of the Node.js API gateway (React → Node → Python).
# Must include /api — requests are appended as /quantum/execute.
VITE_API_URL=http://localhost:3000/api

# Public Google OAuth client ID (safe to expose to the browser — this is NOT a secret).
# Used by the frontend to obtain a Google ID token that is sent to the backend for verification.
# Required only for the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=your_google_client_id